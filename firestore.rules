rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then Publish.
// Only signed-in Google accounts on the company domain can read or change the
// tracker. Keep the domain in sync with allowedEmailDomain in firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    match /tracker/{key} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@uncagedinnovations[.]com$');
    }
  }
}
